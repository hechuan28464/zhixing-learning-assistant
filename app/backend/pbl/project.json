            ],
            "evaluatorRefs": [
              "tests/check.py"
            ]
          }
        },
        {
          "kind": "check",
          "checker": "quiz"
        },
        {
          "kind": "mentor_say",
          "agent": "mentor",
          "say": "Reflect on the recorded plan, implementation, tests and learner feedback.",
          "skill": "recap",
          "reads": [
            "plan",
            "code"
          ],
          "studentActions": [
            "chat",
            "next"
          ]
        }
      ],
      "quiz": [
        {
          "q": "同一个主题出现两次时，应怎样更新汇总结果？",
          "options": [
            "覆盖为最后一次时长",
            "在已有时长上累加",
            "每次都清空结果"
          ],
          "answer": 1,
          "explain": "累计值需要保留之前的记录，再加上本次时长。"
        },
        {
          "q": "函数返回正确的结果，是否足以证明你能在新情境中独立完成？",
          "options": [
            "是，代码通过就全部学会了",
            "还需要独立解释和新任务表现"
          ],
          "answer": 1,
          "explain": "运行结果与学习者理解属于不同证据。"
        }
      ],
      "goal": "实现 summarize(records)，合并同主题的分钟数。",
      "decisions": [
        "record-shape"
      ]
    }
