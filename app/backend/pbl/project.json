            "next"
          ]
        },
        {
          "kind": "dialogue",
          "agent": "discussion",
          "reads": [
            "contract"
          ],
          "collects": "decisions",
          "studentActions": [
            "chat",
            "decide",
            "next"
          ]
        },
        {
          "kind": "produce",
